+# Recovered PROD warehouse schema
+# Source: bitgn/ecom1-prod trial vm2-Lxo3DJGXZSeHp6Y9uxE7bM1hyDi
+# Recovered on 2026-05-30 from live /proc JSON records via /bin/jq and /bin/cat.
+#
+# /bin/sql is unavailable in this prod runtime:
+#   Microsoft ODBC Driver 18 for SQL Server: Login timeout expired.
+#   The PowerTools PROD MS SQL cluster is down. Wait 8 seconds and retry.
+#
+# This is not a literal sqlite_schema dump. It is the operational schema
+# inferred from the live file-shaped warehouse projection. The useful clue is
+# that /bin/jq can read JSON records even when /bin/sql cannot, for example:
+#   /bin/jq keys /proc/payment-ledger/cust-0101/pay-0001.json
+#   /bin/jq .lines[] /proc/payment-ledger/cust-0101/pay-0001.json
+#
+# Observed live families and row counts:
+#   /proc/carts              97 basket records, 135 basket lines
+#   /proc/catalog           101 product records
+#   /proc/locations          17 store records, 602 store inventory rows
+#   /proc/payment-ledger     65 payment records, 92 payment lines
+#   /proc/return-workflows   24 return records
+#   /proc/staff             120 employee records, 377 role rows
+#
+# No customer account table is exposed in the live /proc projection. Customer
+# ids are external ids referenced by carts, payments, and returns.
+
+## Foreign-key edges inferred from /proc
+
+  carts.store_id                    -> locations.id
+  cart_lines.basket_id              -> carts.id
+  cart_lines.sku                    -> catalog.sku
+  carts.discount_issuer_id          -> staff.id
+  location_inventory.store_id       -> locations.id
+  location_inventory.sku            -> catalog.sku
+  location_inventory_incoming.store_id -> locations.id
+  location_inventory_incoming.sku      -> catalog.sku
+  payment_ledger.basket_id          -> carts.id
+  payment_ledger.store_id           -> locations.id
+  payment_lines.payment_id          -> payment_ledger.id
+  payment_lines.sku                 -> catalog.sku
+  payment_three_ds.payment_id       -> payment_ledger.id
+  return_workflows.payment_id       -> payment_ledger.id
+  return_workflows.order_id         -> payment_ledger.order_id
+  staff.store_id                    -> locations.id
+  staff_roles.employee_id           -> staff.id
+
+## Tables
+
+TABLE carts  PK(id)
+  record_path          TEXT  NOT NULL  -- /proc/carts/<customer_id>/<id>.json
+  id                   TEXT  NOT NULL
+  customer_id          TEXT  NOT NULL
+  store_id             TEXT  NOT NULL  -> locations.id
+  status               TEXT  NOT NULL  -- active, abandoned, checked_out
+  created_at           TEXT  NOT NULL
+  discount_percent     INTEGER
+  discount_reason_code TEXT
+  discount_issuer_id   TEXT            -> staff.id
+
+TABLE cart_lines  PK(basket_id, line_number)
+  basket_id    TEXT     NOT NULL  -> carts.id
+  line_number  INTEGER  NOT NULL  -- array order in carts.lines, 1-based
+  sku          TEXT     NOT NULL  -> catalog.sku
+  quantity     INTEGER  NOT NULL
+
+TABLE catalog  PK(sku)
+  record_path       TEXT     NOT NULL  -- /proc/catalog/<brand>/<sku>.json
+  id                INTEGER  NOT NULL
+  sku               TEXT     NOT NULL
+  name              TEXT     NOT NULL
+  brand             TEXT     NOT NULL
+  category_id       TEXT     NOT NULL
+  kind_id           TEXT     NOT NULL
+  family_id         TEXT     NOT NULL
+  price_cents       INTEGER  NOT NULL
+  fulfillment_type  INTEGER  NOT NULL
+  return_policy     INTEGER  NOT NULL
+  properties        TEXT     NOT NULL  -- JSON object
+
+TABLE catalog_properties  PK(sku, property_key)
+  sku              TEXT  NOT NULL  -> catalog.sku
+  property_key     TEXT  NOT NULL
+  value_json       TEXT  NOT NULL
+  value_text       TEXT
+  value_number     REAL
+  value_bool       INTEGER
+
+TABLE locations  PK(id)
+  record_path     TEXT     NOT NULL  -- /proc/locations/<city>/<id>.json
+  id              TEXT     NOT NULL
+  name            TEXT     NOT NULL
+  address_line_1  TEXT     NOT NULL
+  postal_code     TEXT     NOT NULL
+  city            TEXT     NOT NULL
+  country_code    TEXT     NOT NULL
+  is_open         INTEGER  NOT NULL
+  lat             REAL     NOT NULL
+  lon             REAL     NOT NULL
+
+TABLE location_inventory  PK(store_id, sku)
+  store_id  TEXT     NOT NULL  -> locations.id
+  sku       TEXT     NOT NULL  -> catalog.sku
+  on_hand   INTEGER  NOT NULL
+  reserved  INTEGER  NOT NULL
+  -- same-day availability is max(on_hand - reserved, 0)
+  -- missing SKU in a store inventory means same-day availability 0
+
+TABLE location_inventory_incoming  PK(store_id, sku, arrival_in_days)
+  store_id         TEXT     NOT NULL  -> locations.id
+  sku              TEXT     NOT NULL  -> catalog.sku
+  arrival_in_days  INTEGER  NOT NULL
+  quantity         INTEGER  NOT NULL
+
+TABLE payment_ledger  PK(id)
+  record_path                  TEXT     NOT NULL  -- /proc/payment-ledger/<customer_id>/<id>.json
+  id                           TEXT     NOT NULL
+  order_id                     TEXT
+  basket_id                    TEXT              -> carts.id
+  archived                     INTEGER           -- present as true on archived payments
+  customer_id                  TEXT     NOT NULL
+  store_id                     TEXT     NOT NULL  -> locations.id
+  amount_cents                 INTEGER  NOT NULL
+  currency                     TEXT     NOT NULL
+  status                       TEXT     NOT NULL  -- paid, requires_3ds_action
+  created_at                   TEXT     NOT NULL
+  payment_method_fingerprint   TEXT     NOT NULL
+  device_fingerprint           TEXT     NOT NULL
+  observed_lat                 REAL     NOT NULL
+  observed_lon                 REAL     NOT NULL
+
+TABLE payment_lines  PK(payment_id, line_number)
+  payment_id        TEXT     NOT NULL  -> payment_ledger.id
+  line_number       INTEGER  NOT NULL  -- array order in payment_ledger.lines, 1-based
+  sku               TEXT     NOT NULL  -> catalog.sku
+  quantity          INTEGER  NOT NULL
+  unit_price_cents  INTEGER  NOT NULL
+
+TABLE payment_three_ds  PK(payment_id)
+  payment_id      TEXT     NOT NULL  -> payment_ledger.id
+  status          TEXT     NOT NULL  -- 3ds-status1, 3ds-status2, 3ds-status3
+  attempts        INTEGER  NOT NULL
+  max_attempts    INTEGER  NOT NULL
+  retry_after     TEXT
+  failure_reason  TEXT
+
+TABLE return_workflows  PK(id)
+  record_path  TEXT  NOT NULL  -- /proc/return-workflows/<customer_id>/<id>.json
+  id           TEXT  NOT NULL
+  order_id     TEXT  NOT NULL  -> payment_ledger.order_id
+  customer_id  TEXT  NOT NULL
+  payment_id   TEXT  NOT NULL  -> payment_ledger.id
+  status       TEXT  NOT NULL  -- requested, approved, rejected, refund_pending, replacement_pending, closed
+  reason_code  TEXT  NOT NULL
+  created_at   TEXT  NOT NULL
+
+TABLE staff  PK(id)
+  record_path    TEXT  NOT NULL  -- /proc/staff/<store_id>/<id>.json
+  id             TEXT  NOT NULL
+  display_name   TEXT  NOT NULL
+  email          TEXT  NOT NULL
+  title          TEXT  NOT NULL
+  store_id       TEXT  NOT NULL  -> locations.id
+
+TABLE staff_roles  PK(employee_id, role)
+  employee_id  TEXT  NOT NULL  -> staff.id
+  role         TEXT  NOT NULL
+
+## Enumerations and observed optional fields
+
+carts.status:
+  active, abandoned, checked_out
+
+carts.discount object:
